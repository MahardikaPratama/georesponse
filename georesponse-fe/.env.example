# georesponse-fe/.env.example
#
# Variables the frontend reads when run directly with `npm run dev`,
# outside Docker. Copy to .env and adjust if needed.
# See docs/11_devops/ENVIRONMENT_MANAGEMENT.md section 5.1/6.
#
# No VITE_ prefix: the frontend build tool is Rspack, not Vite.

API_BASE_URL=http://localhost:8080/api/v1
LOG_LEVEL=debug

# Raster tile URL template for the map (e.g. an OSM-compatible tile
# server: "https://tile.example.org/{z}/{x}/{y}.png"). Left empty, the map
# renders with no base tiles, only resource markers.
# OpenStreetMap's standard tiles below are free with no signup, suitable
# for local dev only (its usage policy disallows heavy/production traffic
# — see operations.osmfoundation.org/policies/tiles). For a dark theme or
# production use, get a free API key from a provider such as CARTO
# (basemaps.cartocdn.com) or MapTiler and use its tile URL instead.
MAP_TILE_URL=https://api.maptiler.com/maps/darkmatter/{z}/{x}/{y}.png?key=lz4WxgHhicN8zMRvtbih
