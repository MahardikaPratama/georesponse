# georesponse-fe/.env.example
#
# Variables the frontend reads when run directly with `npm run dev`,
# outside Docker. Copy to .env and adjust if needed.
# See docs/11_devops/ENVIRONMENT_MANAGEMENT.md section 5.1/6.
#
# No VITE_ prefix: the frontend build tool is Rspack, not Vite.

API_BASE_URL=http://localhost:8080/api/v1
LOG_LEVEL=debug
