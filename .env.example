# .env.example (root)
#
# Compose-level variables, substituted into docker-compose.yml services.
# Copy to .env and adjust only if a default conflicts with your local setup.
# See docs/11_devops/ENVIRONMENT_MANAGEMENT.md section 6.
#
# Never put a real secret here — these are local-dev-only placeholders.

POSTGRES_USER=georesponse
POSTGRES_PASSWORD=georesponse_dev_password
POSTGRES_DB=georesponse

APP_ENV=development
HTTP_PORT=8080
LOG_LEVEL=debug

API_BASE_URL=http://localhost:8080/api/v1
