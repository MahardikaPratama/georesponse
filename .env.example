# .env.example (root)
#
# Compose-level variables, substituted into docker-compose.yml services.
# Copy to .env and adjust only if a default conflicts with your local setup.
# See docs/11_devops/ENVIRONMENT_MANAGEMENT.md section 6.
#
# Never put a real secret here — these are local-dev-only placeholders.

POSTGRES_USER=georesponse
POSTGRES_PASSWORD=georesponse_dev_password
POSTGRES_DB=georesponse

APP_ENV=development
HTTP_PORT=8080
LOG_LEVEL=debug

# Comma-separated browser origins allowed to call the API cross-origin
# (never a wildcard). The frontend container is served at port 5173.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Signs and verifies authentication tokens (auth.HMACTokenSigner). Must be
# kept confidential; this placeholder is local-dev-only, never a real
# secret.
TOKEN_SECRET=dev-only-secret-do-not-use-in-production
# How long a signed authentication token remains valid.
TOKEN_TTL=24h

# Inlined into the frontend bundle at image build time (docker compose
# build args) — the browser calls the backend at this address directly.
API_BASE_URL=http://localhost:8080/api/v1

# Raster tile URL template for the map, inlined into the frontend bundle at
# image build time. Left empty, the map renders with no base tiles, only
# resource markers. Same value and provider notes as
# georesponse-fe/.env.example (free-tier key, local dev only).
MAP_TILE_URL=https://api.maptiler.com/maps/darkmatter/{z}/{x}/{y}.png?key=lz4WxgHhicN8zMRvtbih

# Image tag docker compose builds/starts for georesponse-fe and
# georesponse-be ("latest" for local dev; scripts/deployment/deploy.sh sets
# an immutable git-SHA tag per build).
IMAGE_TAG=latest
