# georesponse-be/.env.example
#
# Variables the backend reads when run directly with `go run`, outside
# Docker. Copy to .env and adjust if needed.
# See docs/11_devops/ENVIRONMENT_MANAGEMENT.md section 5.2/6.
#
# Never put a real secret here — these are local-dev-only placeholders.

APP_ENV=development
HTTP_PORT=8080
DATABASE_URL=postgres://georesponse:georesponse_dev_password@localhost:5432/georesponse?sslmode=disable
LOG_LEVEL=debug

# Signs and verifies authentication tokens (auth.HMACTokenSigner). Must be
# kept confidential; this placeholder is local-dev-only, never a real
# secret.
TOKEN_SECRET=dev-only-secret-do-not-use-in-production
# How long a signed authentication token remains valid.
TOKEN_TTL=24h
